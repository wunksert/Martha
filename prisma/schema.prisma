// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wishlistItems WishlistItem[]
  
  @@index([email])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  note      String?  // User's note for this wishlist item
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([userId, productId]) // Prevent duplicate wishlist entries
  @@index([userId])
  @@index([productId])
}


model Product {
  id                        String         @id @default(uuid())
  shopifyId                 String         @unique
  shop                      String
  title                     String
  handle                    String
  status                    String
  description               String?
  descriptionHtml           String? // HTML content
  compareAtPriceMin         String?
  compareAtPriceMax         String?
  compareAtPriceCurrencyCode String?
  media                     String? // JSON array of media objects
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  wishlistItems             WishlistItem[]
  
  @@index([shop])
}

model ToDo {
  id        String   @id @default(uuid())
  title     String
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
