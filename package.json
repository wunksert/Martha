{
  "name": "express-ts-server",
  "version": "1.0.0",
  "description": "Express.js server with TypeScript",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && vite build",
    "build:ui": "vite build",
    "build:product_list_widget": "esbuild ui/widgets/ProductListWidget.tsx --bundle --format=esm --jsx=automatic --outfile=dist/ui/assets/products-list.js",
    "build:server": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx --watch src/server.ts",
    "dev:ui": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:ui\"",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "mcp-inspector": "npx @modelcontextprotocol/inspector"
  },
  "keywords": [
    "express",
    "typescript",
    "server"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@openai/apps-sdk-ui": "^0.2.1",
    "@prisma/adapter-better-sqlite3": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "google-auth-library": "^10.5.0",
    "oidc-provider": "^9.5.2",
    "postcss": "^8.5.6",
    "prisma": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/oidc-provider": "^9.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.0",
    "esbuild": "^0.27.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
